
@page "/signup"
@inject Supabase.Client SupabaseClient
@inject NavigationManager Navigation

<div class="login-page">
    <div class="login-card">
        <h1>Create your account</h1>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <input @bind="name"
               type="text"
               placeholder="Name"
               class="form-control mb-3" />

        <input @bind="email"
               type="email"
               placeholder="Email"
               class="form-control mb-3" />

        <input @bind="password"
               type="password"
               placeholder="Password"
               class="form-control mb-3" />

        <button class="btn btn-primary" @onclick="HandleSignUp">
            Register
        </button>

        <p class="mt-3 mb-0">
            Already have an account? <a href="/login">Sign in</a>
        </p>
    </div>
</div>

@code {
    private string name = "";
    private string email = "";
    private string password = "";
    private string? errorMessage;
    private async Task HandleSignUp()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(name) ||
            string.IsNullOrWhiteSpace(email) ||
            string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Name, email, and password are required.";
            return;
        }

        try
        {
            var result = await SupabaseClient.Auth.SignUp(
                email,
                password,
                new Supabase.Gotrue.SignUpOptions
                {
                    Data = new Dictionary<string, object>
                    {
                        ["name"] = name.Trim(),
                        ["onboarding_completed"] = true
                    }
                });

            if (result?.User is null)
            {
                errorMessage = "Signup did not return a user.";
                return;
            }

            if (SupabaseClient.Auth.CurrentSession is not null)
            {
                await SupabaseClient.Auth.Update(new Supabase.Gotrue.UserAttributes
                {
                    Data = new Dictionary<string, object>
                    {
                        ["name"] = name.Trim(),
                        ["onboarding_completed"] = true
                    }
                });
            }

            Navigation.NavigateTo(
                SupabaseClient.Auth.CurrentSession is null ? "/login" : "/onboarding");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }
}
