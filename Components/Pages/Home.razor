@page "/home"

<PageTitle>Home</PageTitle>

<div class="home-page">
    <section class="home-hero">
        <p class="home-eyebrow">See Toronto from a different angle</p>
        <h1 class="feature-hero-title">Find the <span>Unseen Toronto</span></h1>
        <p class="home-intro">
            Build a day around the places and little discoveries most visitors miss.
            Get ideas shaped by your interests, save the places you like, and turn them into
            optional mini adventures.
        </p>
        <div class="home-actions">
            <a class="preferences-save" href="/discover">Discover places</a>
            <a class="home-secondary-action" href="/preferences">Set your preferences</a>
        </div>
    </section>

    <section class="home-guide" aria-label="How the app works">
        <article class="home-tile">
            <span class="home-step">01 · Personalize</span>
            <h2>Start with what you enjoy</h2>
            <p>Choose your interests, travel style, pace, and accessibility needs so suggestions feel more relevant to you.</p>
            <a href="/preferences">Set preferences <span aria-hidden="true">→</span></a>
        </article>
        <article class="home-tile">
            <span class="home-step">02 · Discover</span>
            <h2>Find lesser-known places</h2>
            <p>Explore AI-generated Toronto recommendations that prioritize local discoveries over the usual tourist stops.</p>
            <a href="/discover">Explore places <span aria-hidden="true">→</span></a>
        </article>
        <article class="home-tile">
            <span class="home-step">03 · Make it yours</span>
            <h2>Plan a day with side quests</h2>
            <p>Save places to your day plan, then get quick, optional activities nearby—with TikTok searches for extra inspiration.</p>
            <a href="/plan">Open your day plan <span aria-hidden="true">→</span></a>
        </article>
    </section>

    <section class="home-note">
        <h2>Your day, your way</h2>
        <p>
            Recommendations are starting points, not guarantees. Check venue details before you go,
            and keep every side quest optional.
        </p>
    </section>
</div>
